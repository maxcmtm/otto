# Generated by `python3 platform/otto_cron.py timers infra/systemd` from otto_cron.JOBS — edit JOBS, not this file.
# 25th 06:00 is local time: this ticks hourly and otto_cron.py runs whoever's local time it is.
[Unit]
Description=Otto timer: plan-month — Monthly plan, 25th 06:00 brand time

[Timer]
OnCalendar=*-*-* *:00:00 UTC
Unit=otto-job@plan-month.service
AccuracySec=30s
Persistent=false

[Install]
WantedBy=timers.target
