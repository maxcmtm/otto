# Generated by `python3 platform/otto_cron.py timers infra/systemd` from otto_cron.JOBS — edit JOBS, not this file.
# 18:30 is local time: this ticks hourly and otto_cron.py runs whoever's local time it is.
[Unit]
Description=Otto timer: email-recs — Recommendation e-mails, 18:30 brand time

[Timer]
OnCalendar=*-*-* *:30:00 UTC
Unit=otto-job@email-recs.service
AccuracySec=30s
Persistent=false

[Install]
WantedBy=timers.target
