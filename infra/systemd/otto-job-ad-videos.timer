# Generated by `python3 platform/otto_cron.py timers infra/systemd` from otto_cron.JOBS — edit JOBS, not this file.
# 19:15 is local time: this ticks hourly and otto_cron.py runs whoever's local time it is.
[Unit]
Description=Otto timer: ad-videos — Video ads, 19:15 brand time

[Timer]
OnCalendar=*-*-* *:15:00 UTC
Unit=otto-job@ad-videos.service
AccuracySec=30s
Persistent=false

[Install]
WantedBy=timers.target
