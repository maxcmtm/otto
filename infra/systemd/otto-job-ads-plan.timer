# Generated by `python3 platform/otto_cron.py timers infra/systemd` from otto_cron.JOBS — edit JOBS, not this file.
# 25th 06:15 is local time: this ticks hourly and otto_cron.py runs whoever's local time it is.
[Unit]
Description=Otto timer: ads-plan — Monthly paid plan, 25th 06:15 brand time

[Timer]
OnCalendar=*-*-* *:15:00 UTC
Unit=otto-job@ads-plan.service
AccuracySec=30s
Persistent=false

[Install]
WantedBy=timers.target
