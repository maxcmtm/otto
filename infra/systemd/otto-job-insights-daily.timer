# Generated by `python3 platform/otto_cron.py timers infra/systemd` from otto_cron.JOBS — edit JOBS, not this file.
# 07:05 is local time: this ticks hourly and otto_cron.py runs whoever's local time it is.
[Unit]
Description=Otto timer: insights-daily — Account numbers, 07:05 brand time

[Timer]
OnCalendar=*-*-* *:05:00 UTC
Unit=otto-job@insights-daily.service
AccuracySec=30s
Persistent=false

[Install]
WantedBy=timers.target
