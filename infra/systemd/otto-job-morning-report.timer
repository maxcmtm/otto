# Generated by `python3 platform/otto_cron.py timers infra/systemd` from otto_cron.JOBS — edit JOBS, not this file.
# 07:35 is local time: this ticks hourly and otto_cron.py runs whoever's local time it is.
[Unit]
Description=Otto timer: morning-report — Morning report, 07:35 brand time

[Timer]
OnCalendar=*-*-* *:35:00 UTC
Unit=otto-job@morning-report.service
AccuracySec=30s
Persistent=false

[Install]
WantedBy=timers.target
