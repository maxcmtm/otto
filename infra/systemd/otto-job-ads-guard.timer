# Generated by `python3 platform/otto_cron.py timers infra/systemd` from otto_cron.JOBS — edit JOBS, not this file.
# 06:05 is local time: this ticks hourly and otto_cron.py runs whoever's local time it is.
[Unit]
Description=Otto timer: ads-guard — Paid guard, 06:05 owner time

[Timer]
OnCalendar=*-*-* *:05:00 UTC
Unit=otto-job@ads-guard.service
AccuracySec=30s
Persistent=false

[Install]
WantedBy=timers.target
