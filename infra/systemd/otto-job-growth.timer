# Generated by `python3 platform/otto_cron.py timers infra/systemd` from otto_cron.JOBS — edit JOBS, not this file.
# 05:10 is local time: this ticks hourly and otto_cron.py runs whoever's local time it is.
[Unit]
Description=Otto timer: growth — Growth ledger, 05:10 owner time

[Timer]
OnCalendar=*-*-* *:10:00 UTC
Unit=otto-job@growth.service
AccuracySec=30s
Persistent=false

[Install]
WantedBy=timers.target
