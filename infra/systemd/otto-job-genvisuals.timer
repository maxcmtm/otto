# Generated by `python3 platform/otto_cron.py timers infra/systemd` from otto_cron.JOBS — edit JOBS, not this file.
# 18:00 is local time: this ticks hourly and otto_cron.py runs whoever's local time it is.
[Unit]
Description=Otto timer: genvisuals — Visuals, 18:00 brand time

[Timer]
OnCalendar=*-*-* *:00:00 UTC
Unit=otto-job@genvisuals.service
AccuracySec=30s
Persistent=false

[Install]
WantedBy=timers.target
