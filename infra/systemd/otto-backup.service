# Nightly encrypted backup of /var/lib/otto (+ /etc/otto) to the rclone remote in otto.env (infra/backup.sh).
[Unit]
Description=Otto nightly backup
Documentation=file:///opt/otto/infra/README.md
After=network-online.target
Wants=network-online.target
OnFailure=otto-alert@%N.service

[Service]
Type=oneshot
User=otto
Group=otto
EnvironmentFile=/etc/otto/otto.env
ExecStart=/opt/otto/infra/backup.sh
TimeoutStartSec=3h
Nice=10
IOSchedulingClass=idle
PrivateTmp=yes
ProtectSystem=full
NoNewPrivileges=yes
