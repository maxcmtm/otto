# secrets — never commit
.leonardo_key
*.env
*secret*

# python
__pycache__/
*.pyc
mcp/otto-social-mcp/.venv/

# runtime state & logs (live on server only)
platform/data.json
platform/data.json.bak*
platform/actions.log
platform/genvisuals.log
platform/metrics_history.jsonl

# local backups & scratch screenshots
*.bak.*
*.bak
platform/*.png
platform/*.jpg
*.png
*.jpg

# allow brand/post assets
!platform/assets/**

# local tooling
.claude/

# generated ad statics / reels — rendered on the server, served from /otto/assets, not versioned
platform/assets/ads/
platform/assets/reels/

# motion projects: keep the source (brief, storyboard, script, frame.md, compositions); ignore heavy/generated media
motion/*/node_modules/
motion/*/renders/
motion/*/snapshots/
motion/*/assets/audio/*.wav
motion/*/assets/audio/*.mp3
motion/*/assets/bgm/
motion/*/.hyperframes/frame-packets/
motion/*/.media/

# engine runtime state (server only)
platform/data.json.lock
# owner console runtime state (otto_track / otto_billing / otto_stripe / otto_whop / otto_admin): analytics events, billing
# (and the key that signs checkout references), lead notes, logs
platform/events.jsonl
platform/.track-salt
platform/billing.json
platform/billing.json.lock
platform/.billing-ref-secret
platform/leads.json
platform/leads.json.lock
platform/*.log
platform/publish.log
platform/.telegram-state.json
# approval e-mails (otto_email): used-link nonces + per-brand health, the generated link secret, .eml files written while no
# mail transport is configured (they hold working one-tap links)
platform/.email-state.json
platform/.email-state.json.lock
platform/.email-link-secret
platform/outbox/
# AI usage ledgers (otto_copy, otto_imagegen): per-day calls / images / estimated spend, written next to data.json
platform/copy-usage.json*
platform/imagegen-usage.json*

# motion: regenerable media (source scripts are committed)
motion/*/assets/*.mp4
motion/*/assets/bgm.mp3
motion/otto-showreel-score/*.wav
motion/*/harness-*.html

# full-resolution demo renders (the web copies live in demo/<client>/page/)
demo/gruns/posts/
demo/gruns/ads/
demo/gruns/gruns-reel.mp4

# full-resolution video ads (web copies live in demo/gruns/page/video/)
demo/gruns/video-ads/

# launch kits: the rendered creatives and import media live on disk (≈200 MB per month), not in git —
# launch/<month>/render.py rebuilds them from brands/otto/ads-<month>-*.json
launch/*/creatives/
launch/*/import/media/
launch/*/sheets/
